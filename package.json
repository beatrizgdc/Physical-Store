{
  "name": "physical-store",
  "version": "1.0.0",
  "description": "Este projeto implementa uma aplicação de terminal para encontrar lojas físicas de um eCommerce, utilizando a API do ViaCEP para localizar endereços com base no CEP fornecido pelo usuário. As lojas mais próximas dentro de um raio de 100 km serão priorizadas, e os dados são armazenados em um banco de dados MongoDB.",
  "main": "index.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "start": "ts-node src/app.ts",
    "build": "tsc",
    "dev": "ts-node-dev --respawn src/app.ts",
    "clean": "rimraf dist",
    "test": "jest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "mongoose": "^8.7.2",
    "nodemon": "^3.1.7",
    "winston": "^3.15.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.13",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.7.6",
    "@types/supertest": "^6.0.2",
    "axios": "^1.7.7",
    "jest": "^29.7.0",
    "jest-mock-axios": "^4.7.3",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3"
  }
}
